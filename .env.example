# 火山引擎 AI MediaKit OCR：在 AI MediaKit 控制台 API Key 管理中创建
MEDIAKIT_API_KEY=
MEDIAKIT_OCR_ENDPOINT=https://mediakit.cn-beijing.volces.com/api/v1/tools-sync/image-ocr
MEDIAKIT_UPLOAD_ENDPOINT=https://mediakit.cn-beijing.volces.com/api/v1/tools-sync/request-media-upload-url
MEDIAKIT_OCR_TOOL_VERSION=standard
MEDIAKIT_OCR_TASK_TYPE=spotting

# 火山方舟：豆包 Vision 和 DeepSeek 共用方舟 API 接入方式
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_VISION_MODEL=
ARK_DEEPSEEK_MODEL=

API_TIMEOUT_SECONDS=120
